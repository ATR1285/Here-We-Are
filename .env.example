# Dayflow Environment Variables Configuration
# Do not commit the actual .env file. Use this as a template.

# PostgreSQL Database Configuration
POSTGRES_USER=dayflow_user
POSTGRES_PASSWORD=dayflow_password
POSTGRES_DB=dayflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# FastAPI Backend Configuration
# Use a strong, random 32+ character string for SECRET_KEY in production
SECRET_KEY=change_this_to_a_secure_random_string_in_production
# algorithm for hashing cookies/tokens if applicable, though we use argon2 for passwords
ALGORITHM=HS256
ENVIRONMENT=development
# Allowed origins for CORS (e.g., http://localhost:5173 for Vite)
ALLOWED_ORIGINS=http://localhost:5173

# AI Provider Configuration (Future Phases)
# AI_PROVIDER=openai # or gemini, anthropic
# AI_API_KEY=your_api_key_here
